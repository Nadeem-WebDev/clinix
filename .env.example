# Shared by both server and client (see client/vite.config.js `envDir`).
# Only vars prefixed VITE_ are ever exposed to the browser bundle - everything
# else here stays server-side only. Copy this file to .env and fill in real
# values; never commit .env itself.

NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/clinic-crm-dev
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Allowed frontend origin(s) for CORS - comma-separated if there's more
# than one (e.g. a Vercel domain plus a custom domain). On Render it falls
# back to RENDER_EXTERNAL_URL, which Render sets itself.
CORS_ORIGIN=http://localhost:5173
# true = this server also serves the built React app (client/dist) from the
# same origin - the single-service Render deploy (render.yaml). Leave false
# in dev (Vite serves the client) and for the Vercel + Render split.
SERVE_CLIENT=false

# Client (Vite) - must point at the server above. A production build
# defaults to the same origin (/api/v1), so the Render deploy doesn't set it.
VITE_API_URL=http://localhost:5000/api/v1

# The app's public address, e.g. https://app.clinix.in - used at build time
# for link previews and sitemap.xml (they need full URLs). Optional: on
# Render the service's own URL is used when this is empty.
VITE_SITE_URL=
# Contact details on the public landing page (client/src/pages/Landing.jsx).
# Public by nature - they're shown to every visitor - and read at build time.
# Leave one blank to hide that button; leave both blank to show sign-up only.
# WhatsApp: the number with country code, digits only, e.g. 919822012345.
VITE_CONTACT_EMAIL=
VITE_CONTACT_WHATSAPP=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASSWORD=

# Keep a Render free-plan instance awake: when "true", the server calls its
# own /api/v1/keep-alive every KEEP_ALIVE_INTERVAL_MINUTES (default 13, max
# 14 - Render sleeps after 15). KEEP_ALIVE_URL defaults to
# <RENDER_EXTERNAL_URL>/api/v1/keep-alive on Render. Leave off locally and
# on paid plans.
KEEP_ALIVE_ENABLED=
KEEP_ALIVE_URL=
KEEP_ALIVE_INTERVAL_MINUTES=

# Email notifications via Brevo's transactional email API (not SMTP - the
# four EMAIL_* SMTP vars above are not read by any code). The same messages
# as WhatsApp, sent by server/src/services/email.service.js. Server-side
# only: never prefix these VITE_.
#
# EMAIL_ENABLED is a global kill switch, like WHATSAPP_ENABLED: it must be
# exactly "true" to send anything, so blank (or anything else) means no
# email ever leaves the server.
EMAIL_ENABLED=
# Brevo dashboard -> SMTP & API -> API Keys (starts with "xkeysib-").
BREVO_API_KEY=
# The "From" address. It must be a sender (or a domain) verified in Brevo
# (Senders, Domains & Dedicated IPs), or Brevo rejects the send.
EMAIL_FROM_ADDRESS=
# Shown after the clinic's name in the From line: "Sunrise Family Clinic via
# Clinix". Defaults to Clinix.
EMAIL_FROM_NAME=

# WhatsApp Cloud API (Meta, direct - not a BSP like Wati/Interakt).
# Server-side only: never prefix any of these VITE_, or the access token
# would be compiled into the browser bundle.
#
# WHATSAPP_ENABLED is a hard global kill switch, independent of the
# per-clinic Clinic.whatsappEnabled toggle. Left false, nothing in this app
# ever opens a connection to graph.facebook.com - which is what you want
# locally, in CI, and on any environment holding real patient numbers you
# don't intend to message.
WHATSAPP_ENABLED=false
WHATSAPP_CLOUD_API_BASE_URL=https://graph.facebook.com/v20.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Used for the GET handshake Meta performs when you register the webhook.
# Any hard-to-guess string; it just has to match what you typed into Meta.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# App secret from the Meta app dashboard, used to verify the
# X-Hub-Signature-256 header on incoming webhooks. If left blank, webhook
# payloads cannot be verified - acceptable in dev, not in production.
WHATSAPP_APP_SECRET=

# Template names must match what is approved in Meta Business Manager
# exactly. Approval happens outside this repo and names can change, so they
# are configuration rather than constants in code.
WHATSAPP_TEMPLATE_APPOINTMENT_CONFIRMATION=appointment_confirmation
WHATSAPP_TEMPLATE_APPOINTMENT_REMINDER=appointment_reminder
WHATSAPP_TEMPLATE_QUEUE_UPDATE=queue_now_serving
WHATSAPP_TEMPLATE_DOCUMENT_READY=document_ready

# Public base URL of the frontend, used to build the no-login queue link
# (<PUBLIC_APP_URL>/q/<clinic slug>) that goes into WhatsApp messages.
# Falls back to the first CORS_ORIGIN entry when unset.
PUBLIC_APP_URL=http://localhost:5173

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
